# Flymo Bridge — ESP-IDF defaults (native port)
# Regenerate sdkconfig with: idf.py set-target esp32

# --- Flash / partitions (ESP32-WROOM-32, 4 MB) ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- Bluetooth: NimBLE (native), central role ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
# Bonding / Secure connections (Just Works) — persisted in NVS
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# The mower requires a large ATT MTU (the Android app calls requestMtu(517))
# before it will echo the channel-setup handshake frame. The default 256 (and
# whatever the mower offers, ~65) is too small, so set the host preferred MTU
# high at compile time as well as at runtime (ble_att_set_preferred_mtu).
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517

# --- FreeRTOS / misc ---
CONFIG_FREERTOS_HZ=1000

# --- Logging ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
